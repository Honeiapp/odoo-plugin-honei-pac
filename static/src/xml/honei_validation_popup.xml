<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="honei_terminal.HoneiValidationPopup" owl="1">
        <Dialog title="props.title || _t('Procesando pago honei')"
                size="'md'"
                footer="footer"
                contentClass="state.status === 'processing' || state.status === 'loading' ? 'honei-no-close' : ''">
            <main class="body">
                <p class="text-muted mb-3" t-if="props.terminal">
                    <t t-esc="_t('Terminal:')"/>
                    <strong class="ms-1"><t t-esc="props.terminal.name"/></strong>
                </p>
                <div t-if="state.status === 'loading' || state.status === 'processing'" class="text-center mt-2 py-3">
                    <i class="fa fa-spinner fa-spin fa-2x mb-2 d-block text-primary"/>
                    <p class="mb-0"><t t-esc="state.statusMessage"/></p>
                </div>
                <div t-if="state.status === 'error'" class="mt-3">
                    <div class="alert alert-danger mb-0">
                        <strong class="me-1"><t t-esc="_t('Error:')"/></strong>
                        <t t-esc="state.errorMessage"/>
                    </div>
                </div>
            </main>
            <t t-set-slot="footer">
                <button
                    class="btn btn-primary"
                    t-on-click="confirm"
                    t-if="state.status === 'error'">
                    <t t-esc="_t('Reintentar')"/>
                </button>
                <button
                    class="btn btn-danger"
                    t-on-click="cancel"
                    t-att-disabled="state.cancelling"
                    t-if="state.abortUrl &amp;&amp; (state.status === 'processing' || state.status === 'loading')">
                    <i t-if="state.cancelling" class="fa fa-spinner fa-spin me-1"/>
                    <t t-if="state.cancelling" t-esc="_t('Cancelando...')"/>
                    <t t-if="!state.cancelling" t-esc="isRefund ? _t('Cancelar devolución') : _t('Cancelar pago')"/>
                </button>
                <button
                    class="btn btn-secondary"
                    t-on-click="cancel"
                    t-if="state.status === 'error'">
                    <t t-esc="props.cancelText || _t('Cancelar')"/>
                </button>
            </t>
        </Dialog>
    </t>
</templates>
