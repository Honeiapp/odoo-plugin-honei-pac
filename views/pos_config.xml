<odoo>
  <data>

    <record model="ir.ui.view" id="pos_config_view_form_honei_terminal">
      <field name="model">pos.config</field>
      <field name="name">pos.config.form.honei_terminal</field>
      <field name="inherit_id" ref="point_of_sale.pos_config_view_form"/>
      <field name="arch" type="xml">
        <sheet position="inside">
          <notebook>
            <page string="Honei Terminal">
              <field name="honei_terminal_ids">
                <list editable="bottom">
                  <field name="name"/>
                  <field name="terminal_id"/>
                </list>
              </field>
            </page>
          </notebook>
        </sheet>
      </field>
    </record>

  </data>
</odoo>
