<odoo>
  <data>

    <record model="ir.ui.view" id="pos_config_view_form_honei_terminal">
      <field name="model">pos.config</field>
      <field name="name">pos.config.form.honei_terminal</field>
      <field name="inherit_id" ref="point_of_sale.pos_config_view_form"/>
      <field name="arch" type="xml">
        <sheet position="inside">
          <notebook>
            <page string="honei Terminal">
              <field name="honei_has_local_mode" invisible="1"/>
              <div class="text-muted mb-2" invisible="not honei_has_local_mode">
                Integración local: indica la IP de cada terminal y pulsa <strong>Vincular</strong>
                (necesita Internet solo esa vez; volver a vincular rota la clave).
                Las cajas deben estar en la misma red que los terminales; si un terminal no responde, se cobra por la nube.
              </div>
              <field name="honei_terminal_ids">
                <list editable="bottom">
                  <field name="name"/>
                  <field name="terminal_id"/>
                  <field name="local_host" column_invisible="not parent.honei_has_local_mode"/>
                  <field name="local_secret" password="True" optional="hide"
                         column_invisible="not parent.honei_has_local_mode"/>
                  <field name="local_key_issued_at" optional="hide"
                         column_invisible="not parent.honei_has_local_mode"/>
                  <field name="local_status" column_invisible="not parent.honei_has_local_mode"/>
                  <button name="action_honei_local_provision" type="object" string="Vincular"
                          icon="fa-link" column_invisible="not parent.honei_has_local_mode"
                          confirm="Se emitirá una clave nueva para este terminal y la anterior dejará de funcionar. ¿Continuar?"/>
                </list>
              </field>
            </page>
          </notebook>
        </sheet>
      </field>
    </record>

  </data>
</odoo>
